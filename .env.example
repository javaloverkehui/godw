# 生产部署环境变量。复制成 .env 后修改，不要把 .env 提交到仓库。
#
#   cp .env.example .env
#   openssl rand -base64 32     # 生成 GODW_JWT_SECRET
#
# 带 (必填) 的两项没有默认值，compose 会在启动前就报错——
# 宁可起不来，也不要拿默认口令上线。

# ---- 元数据库 ----
GODW_DB_USER=godw
GODW_DB_PASSWORD=            # (必填) 改成强口令
GODW_DB_DATABASE=godw

# ---- 认证 ----
GODW_JWT_SECRET=             # (必填) 32 字节以上随机串
GODW_ADMIN_EMAIL=admin@godw.local
# 留空则首次启动时随机生成并打印到日志（只打印一次）
GODW_ADMIN_PASSWORD=

# ---- 对象存储（导出文件、备份用） ----
GODW_MINIO_USER=godw
GODW_MINIO_PASSWORD=         # (必填) 改成强口令

# ---- 镜像 ----
GODW_IMAGE=ghcr.io/godw/godw:latest

# ---- 可选：外部 ClickHouse ----
# GODW_CH_HOST=
# GODW_CH_PORT=9000
